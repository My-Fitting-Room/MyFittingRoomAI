# Force Node 22 for React Native pods
ENV['NODE_BINARY'] = '/opt/homebrew/opt/node@22/bin/node'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end


use_frameworks! :linkage => :static

target 'MyFittingRoomAI' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    # Patch fmt at the source so consteval is OFF for every target (Xcode 26 fix)
    fmt_base = File.join(__dir__, 'Pods', 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base)
      original = File.read(fmt_base)
      patched = original.gsub(/define\s+FMT_USE_CONSTEVAL\s+1\b/, 'define FMT_USE_CONSTEVAL 0')
      File.chmod(0644, fmt_base)
      File.write(fmt_base, patched) if patched != original
    end
    # Fix for fmt consteval build errors on Xcode 26 (facebook/react-native#55601)
    installer.pods_project.targets.each do |target|
      if target.name == 'fmt' || target.name == 'RCT-Folly'
        target.build_configurations.each do |build_config|
          build_config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
          build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
          build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'FMT_USE_CONSTEVAL=0'
        end
      end
    end
    
    # Fix for header file conflicts - disable strict include checks
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # Disable strict framework header checking
        config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
        config.build_settings['CLANG_WARN_DOCUMENTATION_COMMENTS'] = 'NO'
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        config.build_settings['DEFINES_MODULE'] = 'YES'
        
        # Force C++20 for most pods (required by RN 0.78)
        # BUT use C++17 for fmt to avoid consteval bugs in modern Xcode
        if target.name == 'fmt' || target.name == 'RCT-Folly'
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'gnu++17'
        else
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'gnu++20'
        end

        # Comprehensive FMT fixes
        [
          ['GCC_PREPROCESSOR_DEFINITIONS', 'FMT_HEADER_ONLY=1'],
          ['GCC_PREPROCESSOR_DEFINITIONS', 'FMT_USE_CONSTEVAL=0'],
          ['GCC_PREPROCESSOR_DEFINITIONS', 'FMT_USE_CONSTEXPR=0'],
          ['OTHER_CPLUSPLUSFLAGS', '-DFMT_USE_CONSTEVAL=0'],
          ['OTHER_CPLUSPLUSFLAGS', '-DFMT_USE_CONSTEXPR=0'],
          ['OTHER_CPLUSPLUSFLAGS', '-DFMT_HEADER_ONLY=1'],
          ['OTHER_CPLUSPLUSFLAGS', '-Wno-invalid-constexpr']
        ].each do |key, value|
          existing = config.build_settings[key]
          if existing.nil?
            config.build_settings[key] = ['$(inherited)', value]
          elsif existing.is_a?(String)
            unless existing.include?(value)
              config.build_settings[key] = "#{existing} #{value}".strip
            end
          elsif existing.is_a?(Array)
            unless existing.include?(value)
              config.build_settings[key] << value
            end
          end
        end

        # Fix for old deployment targets
        config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64' if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 11.0
      end
    end
  end
end




target 'OneSignalNotificationServiceExtension' do
  pod 'OneSignalXCFramework', '>= 5.0.0', '< 6.0'
end